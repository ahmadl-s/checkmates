# Discord bot token (required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=

# Comma-separated list of Discord channel IDs to monitor (required)
# Example: PROJECT_CHANNEL_IDS=123456789012345678,987654321098765432
PROJECT_CHANNEL_IDS=

# Logging level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SQLite database file path (optional, default: checkmates.db)
DATABASE_PATH=checkmates.db

# Project-local timezone for deadline display (optional, default: UTC)
# Use IANA timezone names: e.g., America/New_York, Asia/Tokyo, Europe/London
TIMEZONE=UTC

# Maximum number of recent messages to include in project context (optional, default: 50)
# Used by the context retrieval service when gathering history for AI extraction
CONTEXT_MAX_MESSAGES=50

# Google Gemini API key for AI task extraction (required for extraction service)
# Get a free-tier key from https://aistudio.google.com/apikey
# IMPORTANT: To guarantee zero API spending, use a Google AI project that:
#   1. Has NOT linked a billing account
#   2. Remains on the Free usage tier
# The application-level daily request cap below is a courtesy safeguard only.
# It does NOT control Google's billing. Verify your tier in Google AI Studio.
GEMINI_API_KEY=

# Gemini model for structured output extraction (optional, default: gemini-2.5-flash-lite)
# Must support structured outputs (response_schema with JSON schema)
# Free-tier options: gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
# NOTE: Free-tier rate limits (RPM/RPD) are NOT guaranteed and may change.
#       Check https://ai.google.dev/gemini-api/docs/rate-limits for current limits.
GEMINI_MODEL=gemini-2.5-flash-lite

# Gemini request timeout in seconds (optional, default: 30)
GEMINI_TIMEOUT=30

# Maximum concurrent Gemini API requests (optional, default: 1)
# Set to 1 for conservative free-tier usage. Increase only on paid tiers.
GEMINI_MAX_CONCURRENT=1

# Application-level daily request limit (optional, default: 50)
# This is a courtesy cap — it does NOT replace Google's server-side quota.
# On process restart, the in-memory counter resets to zero.
# Google's RPD quota resets at midnight Pacific time (not UTC).
# These are separate safeguards: the app cap limits our requests early;
# Google's quota is the authoritative guard.
GEMINI_DAILY_REQUEST_LIMIT=50

# Minimum message length (characters) for extraction pre-filter (optional, default: 10)
# Messages shorter than this are skipped unless they contain positive task signals
EXTRACTION_MIN_MESSAGE_LENGTH=10

# Maximum items in the extraction queue (optional, default: 50)
# When the queue is full, new messages are persisted to the database but
# extraction is skipped with a warning log. Increase if you expect bursts.
EXTRACTION_QUEUE_CAPACITY=50

# Timeout for draining the extraction queue during shutdown (optional, default: 10)
# On shutdown, the bot waits up to this many seconds for queued extraction work
# to complete before cancelling the worker. Remaining items are abandoned.
EXTRACTION_SHUTDOWN_TIMEOUT=10
